rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(companyId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.active == true;
    }
    match /users/{uid}/companies/{companyId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /companies/{companyId} {
      allow get: if member(companyId);
      allow list, write: if false;
      match /drafts/{draftId} {
        allow read: if member(companyId);
        allow write: if false;
      }
      match /members/{uid} {
        allow get: if request.auth != null && request.auth.uid == uid && member(companyId);
        allow list, write: if false;
      }
      match /audit/{eventId} {
        allow read: if member(companyId) &&
          get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.role == 'owner';
        allow write: if false;
      }
    }
    // Spark: espacio privado del operador; solo borradores inmutables.
    function own(uid) { return request.auth != null && request.auth.uid == uid; }
    function shortText(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function boundedText(v, max) { return v is string && v.size() <= max; }
    function isoDate(v) {
      return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    function isoDateOrNull(v) { return v == null || isoDate(v); }
    function currencyCode(v) { return v is string && v.matches('^[A-Z]{3}$'); }
    function validLine(l) {
      let q = l.quantityUnits;
      let p = l.priceCents;
      let base = int((q * p + 5000) / 10000);
      return l.keys().hasOnly(['description','quantityUnits','priceCents','rate','subtotalCents','taxCents','taxTreatment','discountBps','grossCents','discountCents']) &&
        shortText(l.description,200) && q is int && q > 0 && q <= 100000000 &&
        p is int && p > 0 && p <= 10000000000 && q * p <= 100000000000000 && base > 0 &&
        l.subtotalCents is int && l.taxCents is int &&
        (l.keys().hasAny(['taxTreatment','discountBps','grossCents','discountCents']) ?
          l.keys().hasAll(['taxTreatment','discountBps','grossCents','discountCents']) &&
          l.discountBps is int && l.discountBps >= 0 && l.discountBps <= 10000 &&
          l.grossCents == base && l.discountCents is int && l.discountCents == int((base * l.discountBps + 5000) / 10000) &&
          l.subtotalCents == base - l.discountCents &&
          (l.taxTreatment == 'TAXED' ? l.rate in [5,19] : l.taxTreatment in ['EXEMPT','EXCLUDED','NOT_SUBJECT'] && l.rate == 0)
          : l.rate in [5,19] && l.subtotalCents == base) &&
        l.taxCents == int((l.subtotalCents * l.rate + 50) / 100);
    }
    function checkLine(ls, i) { return ls.size() <= i || validLine(ls[i]); }
    function sumLines(ls, field) {
      return (ls.size() > 0 ? ls[0][field] : 0)+(ls.size() > 1 ? ls[1][field] : 0)+(ls.size() > 2 ? ls[2][field] : 0);
    }
    function validDraft(d) {
      let ls = d.lines;
      return d.keys().hasOnly(['kind','buyer','reference_id','reason','currency','lines','subtotalCents','taxCents','totalCents','status','fiscal_validity','requestHash','createdAt','version','auditId','updatedBy','updatedAt','referenceLocked','lastOperation','schemaVersion','context','payment']) &&
        (d.get('schemaVersion',1) == 1 ? !d.keys().hasAny(['context','payment','schemaVersion']) : d.schemaVersion == 2 && d.keys().hasAll(['context','payment'])) &&
        d.status == 'DRAFT' && d.fiscal_validity == false && d.currency == 'COP' &&
        d.createdAt is timestamp && d.requestHash is string && d.requestHash.matches('^[a-f0-9]{64}$') &&
        d.buyer.keys().hasOnly(['name','identification']) && shortText(d.buyer.name,200) &&
        d.buyer.identification is string && d.buyer.identification.matches('^[0-9]{5,15}$') &&
        ls is list && ls.size() > 0 && ls.size() <= 3 && checkLine(ls,0) &&
        d.subtotalCents is int && d.taxCents is int && d.totalCents is int &&
        d.subtotalCents == sumLines(ls,'subtotalCents') && d.taxCents == sumLines(ls,'taxCents') &&
        d.totalCents == d.subtotalCents + d.taxCents;
    }
    function validProfile(p) {
      return p.keys().hasOnly(['name','documentType','identification','dv','email','phone','address','department','municipality','taxResponsibilities','vatStatus','createdAt','updatedAt','version','auditId','updatedBy']) &&
        shortText(p.name,200) && p.documentType in ['NIT','CC','CE'] &&
        p.identification is string && p.identification.matches('^[0-9]{5,15}$') &&
        p.dv is string && (p.documentType == 'NIT' ? p.dv.matches('^[0-9]$') : p.dv == '') &&
        shortText(p.email,254) && p.email.matches('^[^ @]+@[^ @]+[.][^ @]+$') &&
        p.phone is string && p.phone.size() <= 30 && shortText(p.address,250) &&
        shortText(p.department,100) && shortText(p.municipality,100) && shortText(p.taxResponsibilities,300) &&
        p.vatStatus in ['responsable','no_responsable','por_confirmar'] &&
        p.createdAt is timestamp && p.updatedAt == request.time;
    }
    function profileChange() {
      return request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.identification == resource.data.identification &&
        request.resource.data.documentType == resource.data.documentType;
    }
    // Archivo anterior: su propietario conserva lectura, sin nuevas escrituras.
    match /workspaces/{uid}/companies/{companyId} {
      allow read: if own(uid);
      allow write: if false;
      match /{document=**} {
        allow read: if own(uid);
        allow write: if false;
      }
    }
    function platformAdmin() { return request.auth != null && request.auth.token.get('platformAdmin', false) == true; }
    function verified() { return request.auth != null && request.auth.token.get('email_verified', false) == true; }
    function orgRole(data) { return verified() ? data.members.get(request.auth.token.email, '') : ''; }
    function orgAccess(id, roles) {
      return platformAdmin() || orgRole(get(/databases/$(database)/documents/organizations/$(id)).data) in roles;
    }
    function orgReference(id, d) {
      return (d.kind == 'INVOICE' && d.reference_id == null && d.reason == null) ||
        (d.kind in ['CREDIT_NOTE','DEBIT_NOTE'] && shortText(d.reference_id,80) && shortText(d.reason,500) &&
        get(/databases/$(database)/documents/organizations/$(id)/drafts/$(d.reference_id)).data.kind == 'INVOICE' &&
        get(/databases/$(database)/documents/organizations/$(id)/drafts/$(d.reference_id)).data.buyer == d.buyer && getAfter(/databases/$(database)/documents/organizations/$(id)/drafts/$(d.reference_id)).data.referenceLocked == true);
    }
    function registered() {
      return verified() && exists(/databases/$(database)/documents/registeredUsers/$(request.auth.uid));
    }
    function auditWrite(companyId,target,id,before) {
      let d = request.resource.data;
      let e = getAfter(/databases/$(database)/documents/organizations/$(companyId)/audit/$(d.auditId)).data;
      return registered() && d.auditId is string && d.auditId.matches('^[a-zA-Z0-9-]{20,80}$') &&
        d.updatedAt == request.time && d.updatedBy == request.auth.uid &&
        d.version == (before == null ? 1 : before.get('version',0)+1) &&
        e.target == target && e.targetId == id && e.before == before && e.after == d &&
        e.actorUid == request.auth.uid && e.actorEmail == request.auth.token.email && e.at == request.time;
    }
    function validUser(p,uid) {
      return p.keys().hasOnly(['uid','email','firstName','lastName','documentType','identification','phone','jobTitle','createdAt']) &&
        p.uid == uid && p.email == request.auth.token.email && p.createdAt == request.time &&
        shortText(p.firstName,80) && shortText(p.lastName,80) && p.documentType in ['CC','CE','PASAPORTE'] &&
        p.identification is string && p.identification.matches('^[A-Za-z0-9-]{5,30}$') && shortText(p.phone,30) && shortText(p.jobTitle,100);
    }
    match /registeredUsers/{uid} {
      allow get: if own(uid) || platformAdmin();
      allow list: if platformAdmin();
      allow create: if own(uid) && validUser(request.resource.data,uid);
      allow update,delete: if false;
    }
    // Una reserva global por correo impide membresías simultáneas entre compañías.
    match /companyAssignments/{email} {
      allow get: if platformAdmin() || (registered() && email == request.auth.token.email);
      allow list: if platformAdmin();
      allow create: if registered() && request.resource.data.keys().hasOnly(['companyId']) &&
        request.resource.data.companyId is string &&
        orgAccess(request.resource.data.companyId,['admin']) &&
        getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.companyId)).data.memberChangeEmail == email &&
        getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.companyId)).data.updatedAt == request.time &&
        getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.companyId)).data.members.get(email,'') in ['admin','billing','viewer'];
      allow update: if false;
      allow delete: if registered() && orgAccess(resource.data.companyId,['admin']) &&
        getAfter(/databases/$(database)/documents/organizations/$(resource.data.companyId)).data.memberChangeEmail == email &&
        getAfter(/databases/$(database)/documents/organizations/$(resource.data.companyId)).data.updatedAt == request.time &&
        !getAfter(/databases/$(database)/documents/organizations/$(resource.data.companyId)).data.members.keys().hasAny([email]);
    }
    function singleCompanyChange(id) {
      let email=request.resource.data.memberChangeEmail;
      let members=request.resource.data.members;
      return email is string && email.size() > 3 && email.size() <= 254 &&
        members.diff(resource.data.members).affectedKeys().hasOnly([email]) &&
        (members.keys().hasAny([email])
          ? getAfter(/databases/$(database)/documents/companyAssignments/$(email)).data.companyId == id
          : !existsAfter(/databases/$(database)/documents/companyAssignments/$(email)));
    }
    match /organizations/{companyId} {
      function nativeKey(id) { return id is string && id.matches('^new_[a-f0-9-]{36}$'); }
      function commercialAccountLink(key,id) {
        return key is string && id is string &&
          (nativeKey(key) ? id == key && exists(/databases/$(database)/documents/organizations/$(companyId)/commercialAccounts/$(key)) :
           key.matches('^[a-f0-9]{64}$') && id == 'legacy-account-' + string(get(/databases/$(database)/documents/organizations/$(companyId)/legacyData/accounts/records/$(key)).data.data.id));
      }
      function commercialContactLink(key,id,accountId) {
        return key is string && id is string &&
          (nativeKey(key) ? id == key && get(/databases/$(database)/documents/organizations/$(companyId)/commercialContacts/$(key)).data.customerId == accountId :
           key.matches('^[a-f0-9]{64}$') && id == 'legacy-contact-' + string(get(/databases/$(database)/documents/organizations/$(companyId)/legacyData/contacts/records/$(key)).data.data.id) &&
           accountId == 'legacy-account-' + string(get(/databases/$(database)/documents/organizations/$(companyId)/legacyData/contacts/records/$(key)).data.data.account_id));
      }
      function commercialOfficeLink(key,id,contactKey,contactId) {
        return key == '' && id == '' || (key is string && id is string &&
          (nativeKey(key) ? id == key && get(/databases/$(database)/documents/organizations/$(companyId)/commercialOffices/$(key)).data.contactId == contactId :
           key.matches('^[a-f0-9]{64}$') && id == 'legacy-office-' + string(get(/databases/$(database)/documents/organizations/$(companyId)/legacyData/offices/records/$(key)).data.data.id) &&
           get(/databases/$(database)/documents/organizations/$(companyId)/legacyData/offices/records/$(key)).data.data.contact_id == get(/databases/$(database)/documents/organizations/$(companyId)/legacyData/contacts/records/$(contactKey)).data.data.id));
      }

      match /commercialContacts/{id} {
        function validRecord(d) { return d.keys().hasOnly(['name', 'jobTitle', 'phone1', 'phone2', 'mobile', 'email', 'comments', 'sourceId', 'sourceDocumentId', 'createdAt', 'version', 'auditId', 'updatedBy', 'updatedAt','customerId','accountDocumentId']) &&
          d.sourceDocumentId == id && ((d.sourceId == null && nativeKey(id) && commercialAccountLink(d.accountDocumentId,d.customerId)) || (id.matches('^[a-f0-9]{64}$') && d.sourceId is int && get(/databases/$(database)/documents/organizations/$(companyId)/legacyData/contacts/records/$(id)).data.data.id == d.sourceId && !d.keys().hasAny(['customerId', 'accountDocumentId']))) &&
          shortText(d.name,200) &&
          d.name is string && d.name.size() <= 200 &&
          d.jobTitle is string && d.jobTitle.size() <= 200 &&
          d.phone1 is string && d.phone1.size() <= 40 &&
          d.phone1.matches('^[0-9]*$') &&
          d.phone2 is string && d.phone2.size() <= 40 &&
          d.phone2.matches('^[0-9]*$') &&
          d.mobile is string && d.mobile.size() <= 40 &&
          d.mobile.matches('^[0-9]*$') &&
          d.email is string && d.email.size() <= 254 &&
          (d.email == '' || d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')) &&
          d.comments is string && d.comments.size() <= 4000 &&
          d.createdAt is timestamp; }
        allow read: if companyId == '500123568' && orgAccess(companyId,['admin','viewer']);
        allow create: if companyId == '500123568' && orgAccess(companyId,['admin']) && validRecord(request.resource.data) && request.resource.data.createdAt == request.time && auditWrite(companyId,'commercialContacts',id,null);
        allow update: if companyId == '500123568' && orgAccess(companyId,['admin']) && validRecord(request.resource.data) && request.resource.data.sourceId == resource.data.sourceId && request.resource.data.createdAt == resource.data.createdAt  && (resource.data.sourceId != null || (request.resource.data.customerId == resource.data.customerId && request.resource.data.accountDocumentId == resource.data.accountDocumentId)) && auditWrite(companyId,'commercialContacts',id,resource.data);
        allow delete: if false;
      }
      match /commercialOffices/{id} {
        function validRecord(d) { return d.keys().hasOnly(['name', 'type', 'address', 'municipality', 'department', 'phone1', 'phone2', 'email', 'technicianName', 'technicianPhone', 'technicianEmail', 'comments', 'sourceId', 'sourceDocumentId', 'createdAt', 'version', 'auditId', 'updatedBy', 'updatedAt','customerId','accountDocumentId','contactId','contactDocumentId']) &&
          d.sourceDocumentId == id && ((d.sourceId == null && nativeKey(id) && commercialAccountLink(d.accountDocumentId,d.customerId) && commercialContactLink(d.contactDocumentId,d.contactId,d.customerId)) || (id.matches('^[a-f0-9]{64}$') && d.sourceId is int && get(/databases/$(database)/documents/organizations/$(companyId)/legacyData/offices/records/$(id)).data.data.id == d.sourceId && !d.keys().hasAny(['customerId', 'accountDocumentId', 'contactId', 'contactDocumentId']))) &&
          shortText(d.name,200) &&
          d.name is string && d.name.size() <= 200 &&
          d.type is string && d.type.size() <= 120 &&
          d.address is string && d.address.size() <= 300 &&
          d.municipality is string && d.municipality.size() <= 120 &&
          d.department is string && d.department.size() <= 120 &&
          d.phone1 is string && d.phone1.size() <= 40 &&
          d.phone1.matches('^[0-9]*$') &&
          d.phone2 is string && d.phone2.size() <= 40 &&
          d.phone2.matches('^[0-9]*$') &&
          d.email is string && d.email.size() <= 254 &&
          (d.email == '' || d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')) &&
          d.technicianName is string && d.technicianName.size() <= 200 &&
          d.technicianPhone is string && d.technicianPhone.size() <= 40 &&
          d.technicianPhone.matches('^[0-9]*$') &&
          d.technicianEmail is string && d.technicianEmail.size() <= 254 &&
          (d.technicianEmail == '' || d.technicianEmail.matches('^[^ @]+@[^ @]+[.][^ @]+$')) &&
          d.comments is string && d.comments.size() <= 4000 &&
          d.createdAt is timestamp; }
        allow read: if companyId == '500123568' && orgAccess(companyId,['admin','viewer']);
        allow create: if companyId == '500123568' && orgAccess(companyId,['admin']) && validRecord(request.resource.data) && request.resource.data.createdAt == request.time && auditWrite(companyId,'commercialOffices',id,null);
        allow update: if companyId == '500123568' && orgAccess(companyId,['admin']) && validRecord(request.resource.data) && request.resource.data.sourceId == resource.data.sourceId && request.resource.data.createdAt == resource.data.createdAt  && (resource.data.sourceId != null || (request.resource.data.customerId == resource.data.customerId && request.resource.data.accountDocumentId == resource.data.accountDocumentId && request.resource.data.contactId == resource.data.contactId && request.resource.data.contactDocumentId == resource.data.contactDocumentId)) && auditWrite(companyId,'commercialOffices',id,resource.data);
        allow delete: if false;
      }

      function validQuotationEdit(q) {
        return q.validUntil is int && q.validUntil >= q.date && q.lines is list && q.lines.size()>0 && q.lines.size()<=3 && validQuotationLine(q.lines[0]) &&
          q.taxCents is int && q.taxCents == quotationSum(q.lines,'taxCents') && q.totalCents is int && q.totalCents == quotationSum(q.lines,'totalCents') &&
          q.paymentMethod is string && q.paymentMethod.size()<=2000 && q.warranty is string && q.warranty.size()<=2000 &&
          q.deliveryTime is string && q.deliveryTime.size()<=2000 && q.comments is string && q.comments.size()<=2000;
      }
      // Scalable quotation revisions: immutable line chain, atomic publication.
      function quoteEditor() { return companyId == '500123568' && orgAccess(companyId,['admin']) && registered(); }
      function quoteReader() { return companyId == '500123568' && orgAccess(companyId,['admin','viewer']); }
      function quoteSums(s) { return s is map && s.keys().hasOnly(['amountCents','discountCents','subtotalCents','taxCents','totalCents']) && s.amountCents is int && s.discountCents is int && s.subtotalCents is int && s.taxCents is int && s.totalCents is int && s.amountCents>=0 && s.discountCents>=0 && s.subtotalCents>=0 && s.taxCents>=0 && s.totalCents>=0 && s.amountCents<=9007199254740991 && s.totalCents<=9007199254740991; }
      function quoteCondition(c) { return c is map && c.keys().hasOnly(['letter','warranty','paymentMethod','comments','purchaseOrder','deliveryDays','deliveryUnit','validityDays','validityUnit','status']) && c.letter is string && c.letter.size()<=10000 && c.warranty is string && c.warranty.size()<=2000 && c.paymentMethod is string && c.paymentMethod.size()<=2000 && c.comments is string && c.comments.size()<=2000 && c.purchaseOrder is string && c.purchaseOrder.size()<=200 && c.deliveryDays is int && c.deliveryDays>=0 && c.deliveryDays<=36500 && c.validityDays is int && c.validityDays>=0 && c.validityDays<=36500 && c.deliveryUnit in ['CALENDAR_DAYS','WORKING_DAYS'] && c.validityUnit in ['CALENDAR_DAYS','WORKING_DAYS'] && c.status in ['CREATED','SENT','APPROVED','REJECTED']; }
      match /commercialQuotationRevisions/{revisionId} {
        allow read: if quoteReader();
        allow create: if quoteEditor() && request.resource.data.keys().hasOnly(['quoteId','ownerUid','sealed','createdAt']) && request.resource.data.quoteId is string && request.resource.data.quoteId.size()>0 && request.resource.data.quoteId.size()<=100 && request.resource.data.ownerUid==request.auth.uid && request.resource.data.sealed==false && request.resource.data.createdAt==request.time;
        allow update: if quoteEditor() && resource.data.ownerUid==request.auth.uid && resource.data.sealed==false && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sealed']) && request.resource.data.sealed==true && getAfter(/databases/$(database)/documents/organizations/$(companyId)/commercialQuotationVersions/$(resource.data.quoteId)).data.revisionId==revisionId;
        allow delete: if false;
        match /lines/{lineId} {
          function parentRevision(){return get(/databases/$(database)/documents/organizations/$(companyId)/commercialQuotationRevisions/$(revisionId)).data;}
          function accumulated(d) {
            let previous=d.index==0?{'amountCents':0,'discountCents':0,'subtotalCents':0,'taxCents':0,'totalCents':0}:getAfter(/databases/$(database)/documents/organizations/$(companyId)/commercialQuotationRevisions/$(revisionId)/lines/$(string(d.index-1))).data.sums;
            return d.sums.amountCents==previous.amountCents+d.line.amountCents && d.sums.discountCents==previous.discountCents+d.line.discountCents && d.sums.subtotalCents==previous.subtotalCents+d.line.subtotalCents && d.sums.taxCents==previous.taxCents+d.line.taxCents && d.sums.totalCents==previous.totalCents+d.line.totalCents;
          }
          allow read: if quoteReader();
          allow create: if quoteEditor() && parentRevision().ownerUid==request.auth.uid && !parentRevision().sealed && request.resource.data.keys().hasOnly(['index','line','sums']) && request.resource.data.index is int && request.resource.data.index>=0 && lineId==string(request.resource.data.index) && validQuotationLine(request.resource.data.line) && quoteSums(request.resource.data.sums) && accumulated(request.resource.data);
          allow update,delete: if false;
        }
      }
      function quoteRevisionPublished(d,id) {
        let path=/databases/$(database)/documents/organizations/$(companyId)/commercialQuotationRevisions/$(d.revisionId);
        let rev=get(path).data;
        let last=getAfter(/databases/$(database)/documents/organizations/$(companyId)/commercialQuotationRevisions/$(d.revisionId)/lines/$(string(d.lineCount-1))).data;
        return rev.quoteId==id && rev.ownerUid==request.auth.uid && rev.sealed==false && getAfter(path).data.sealed==true && last.index==d.lineCount-1 && last.sums==d.totals;
      }
      function quoteRevisionLinks(l) {
        return l is map && l.keys().hasOnly(['customerId','accountDocumentId','contactId','contactDocumentId','officeId','officeDocumentId','approverContactId','approverDocumentId']) && commercialAccountLink(l.accountDocumentId,l.customerId) && commercialContactLink(l.contactDocumentId,l.contactId,l.customerId) && commercialOfficeLink(l.officeDocumentId,l.officeId,l.contactDocumentId,l.contactId) && ((l.approverContactId=='' && l.approverDocumentId=='') || commercialContactLink(l.approverDocumentId,l.approverContactId,l.customerId));
      }
      function quoteRevisionAudit(d) {
        return quoteCondition(d.conditions) && quoteRevisionLinks(d.links) && d.snapshot is map && d.snapshot.keys().hasOnly(['accountName','contactName','officeName','approverName']) && d.snapshot.accountName is string && d.snapshot.accountName.size()<=1000 && d.snapshot.contactName is string && d.snapshot.contactName.size()<=1000 && d.snapshot.officeName is string && d.snapshot.officeName.size()<=1000 && d.snapshot.approverName is string && d.snapshot.approverName.size()<=1000;
      }
      match /commercialQuotationVersions/{id} {
        function shape(d) { return d.keys().hasOnly(['sourceKind','sourceDocumentId','sourceId','number','date','year','sequence','links','snapshot','conditions','revisionId','lineCount','totals','version','auditId','updatedBy','updatedAt']) && d.sourceKind in ['NEW','IMPORTED','NATIVE'] && d.sourceDocumentId is string && d.sourceId is int && d.number is string && d.number.size()<=100 && d.date is int && d.year is int && d.year==timestamp.value(d.date).year() && d.sequence is int && d.sequence>=0 && d.revisionId is string && d.lineCount is int && d.lineCount>0 && quoteSums(d.totals); }
        function original(d) {
          return (d.sourceKind=='IMPORTED' && id=='legacy-quotation-'+string(d.sourceId) && get(/databases/$(database)/documents/organizations/$(companyId)/legacyData/quotations/records/$(d.sourceDocumentId)).data.data.id==d.sourceId) ||
            (d.sourceKind=='NATIVE' && id==d.sourceDocumentId && exists(/databases/$(database)/documents/organizations/$(companyId)/commercialQuotations/$(id))) ||
            (d.sourceKind=='NEW' && nativeKey(id) && !exists(/databases/$(database)/documents/organizations/$(companyId)/commercialQuotations/$(id)) && d.sourceDocumentId=='' && d.sourceId==0 && d.year==(request.time-duration.value(5,'h')).year() && d.number=='COT-'+string(d.year)+'-V2-'+string(d.sequence) && getAfter(/databases/$(database)/documents/organizations/$(companyId)/commercialQuotationCountersV2/$(string(d.year))).data.quoteId==id && getAfter(/databases/$(database)/documents/organizations/$(companyId)/commercialQuotationCountersV2/$(string(d.year))).data.last==d.sequence);
        }
        allow read: if quoteReader();
        allow create: if quoteEditor() && shape(request.resource.data) && original(request.resource.data) && quoteRevisionPublished(request.resource.data,id) && auditWrite(companyId,'commercialQuotationVersions',id,null);
