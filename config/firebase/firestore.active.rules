          id == request.resource.data.period + '_' + request.resource.data.contractId &&
          request.resource.data.status == 'SCHEDULED' && request.resource.data.invoiceReference == '' &&
          request.resource.data.createdAt == request.time && billingScheduleMatchesContract(request.resource.data) &&
          auditWrite(companyId,'billingSchedule',id,null);
        allow update: if orgAccess(companyId,['admin','billing']) && validBillingSchedule(request.resource.data) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','invoiceReference','notes','updatedAt','updatedBy','version','auditId']) &&
          billingScheduleTransition(resource.data.status,request.resource.data.status) &&
          auditWrite(companyId,'billingSchedule',id,resource.data);
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
